# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Auth (NextAuth v5) ──────────────────────────────────────────────────────
NEXTAUTH_SECRET=
# AUTH_SECRET is an accepted alias for NEXTAUTH_SECRET
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App URLs ─────────────────────────────────────────────────────────────────
# Public base URL of the app. Set this explicitly in production (e.g. https://vrutta.net).
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
# RAILWAY_PUBLIC_DOMAIN is injected automatically by Railway and used only as a
# base-URL fallback when NEXT_PUBLIC_APP_URL is not set — no need to set it yourself.

# ── Email (ZeptoMail) ────────────────────────────────────────────────────────
# Mail Agent "Send Mail Token" — the full "Zoho-enczapikey <key>" string or just the key.
ZEPTOMAIL_TOKEN=
# API base URL for your account's data center. Default: https://api.zeptomail.in
# Use https://api.zeptomail.com (US/global) or https://api.zeptomail.eu (Europe).
ZEPTOMAIL_URL=
# From address on a domain verified in ZeptoMail, e.g. "Vrutta <noreply@vrutta.net>"
EMAIL_FROM=

# ── AWS S3 (media uploads) ───────────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_URL=

# ── AI (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Error tracking (Sentry) ──────────────────────────────────────────────────
# Optional. Leave blank to disable — the SDK stays inert when unset.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to run `npm run sentry:sourcemaps` (readable production stack traces).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional build identifier tying events to an uploaded source-map release
# (e.g. the git SHA). Set the same value for both when you upload.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# ── Misc ──────────────────────────────────────────────────────────────────────
# Shared secret required to authorize scheduled/cron API calls
CRON_SECRET=
# debug | info | warn | error (default: info)
LOG_LEVEL=info
