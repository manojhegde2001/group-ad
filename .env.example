# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Auth (NextAuth v5) ──────────────────────────────────────────────────────
NEXTAUTH_SECRET=
# AUTH_SECRET is an accepted alias for NEXTAUTH_SECRET
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── AWS S3 (media uploads) ───────────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_URL=

# ── AI (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Misc ──────────────────────────────────────────────────────────────────────
# Shared secret required to authorize scheduled/cron API calls
CRON_SECRET=
# debug | info | warn | error (default: info)
LOG_LEVEL=info
